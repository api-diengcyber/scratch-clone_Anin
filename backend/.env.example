# ============================================================
# CONTOH ENV BACKEND — SALIN KE .env, JANGAN COMMIT .env
#   cp .env.example .env
#   chmod 600 .env
# ============================================================

# Wajib di production
NODE_ENV=production
PORT=3000

# Database di volume persistent (JANGAN di folder yang hilang saat redeploy).
# Contoh VPS: /data/database.sqlite
DB_PATH=/data/database.sqlite

# Kalau frontend dan backend beda domain, isi origin frontend.
# Satu domain: kosongkan.
FRONTEND_ORIGIN=

# Jumlah hop reverse proxy untuk X-Forwarded-For.
# 1 = Nginx/Caddy langsung, 2 = Cloudflare + Nginx.
TRUST_PROXY=1

# AI Tutor (opsional; tanpa ini fitur lain tetap jalan)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MOCK=
# GROQ_API_KEY=            # opsional, kalau memakai Groq langsung

# Koin & modul AI
FIRST_TRY_BONUS=5
AI_TUTOR_ALLOWED_MODULES=ai1,ai2,ai3,ai4

# Log
LOG_LEVEL=info

# Backup (opsional; default: backend/backups, simpan 7 file terakhir)
# BACKUP_DIR=/data/backups
# BACKUP_KEEP=7

# Plugin Runtime M4-M5 (set in backend AND runtime service; no secrets in Git)
# PLUGIN_DIR harus sama untuk backend dan runtime.
PLUGIN_DIR=/data/plugins
# Runtime plugin WAJIB di origin/subdomain terpisah dari aplikasi utama.
PLUGIN_PUBLIC_ORIGIN=https://plugins.example.com
# Origin aplikasi utama; wajib di production untuk CSP frame-ancestors runtime.
APP_PUBLIC_ORIGIN=https://example.com
# Minimal 32 karakter; jangan commit nilai asli.
PLUGIN_PREVIEW_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
# Comma-separated users.id values belonging to trusted developer admins. Empty means upload/review/publish disabled.
PLUGIN_DEVELOPER_USER_IDS=
# Runtime-only; run npm run start:plugins in a separate process/service
PLUGIN_PORT=3001
